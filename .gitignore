__pycache__/
*.py[cod]
.venv*/
node_modules/
frontend/out/
frontend/.next/
.dev-data/
*.xlsx
!tests/fixtures/**/*.xlsx
# The bundle is vendored verbatim. A workbook it ships is authority,
# and its own manifest hashes it -- an ignore rule must not filter it.
!vendor/**
.DS_Store
.env
bandit.json
# A scanner report is a build output, not a source. The suite writes coverage.xml
# for the analysis to import and .coverage as its own working file; the report
# reaching the `sonarqube` job is the one CI just produced, never a committed one.
coverage.xml
.coverage
uv.lock
